{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/marks/**",
              "components/print/**",
              "components/ui/**",
              "ui_kits/docs-reader/**",
              "ui_kits/pdf-document/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|iconLeft|iconRight|full|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, iconLeft, iconRight, full, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: title, children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|accent|quiet)$/]",
        "message": "<Callout> tone must be one of 'info' | 'accent' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|year|range|subtitle|band|style|key|ref|className|style|children)$/]",
        "message": "<CoverBlock> doesn't accept that prop. Declared props: title, eyebrow, year, range, subtitle, band, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|grain|bleed|head|footer|margin|shadow|style|children|key|ref|className|style|children)$/]",
        "message": "<DocPage> doesn't accept that prop. Declared props: size, grain, bleed, head, footer, margin, shadow, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocPage'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:letter|a4)$/]",
        "message": "<DocPage> size must be one of 'letter' | 'a4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|caption|credit|ratio|children|style|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: number, caption, credit, ratio, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyValueItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<KeyValueItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lede'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dropRule|style|key|ref|className|style|children)$/]",
        "message": "<Lede> doesn't accept that prop. Declared props: children, dropRule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<Metric> doesn't accept that prop. Declared props: value, unit, label, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|accent|ink)$/]",
        "message": "<Metric> tone must be one of 'navy' | 'accent' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Metric> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|total|label|rule|style|key|ref|className|style|children)$/]",
        "message": "<PageFooter> doesn't accept that prop. Declared props: page, total, label, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|align|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, attribution, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PullQuote> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunningHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|section|rule|style|key|ref|className|style|children)$/]",
        "message": "<RunningHead> doesn't accept that prop. Declared props: title, section, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|subtitle|level|rule|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: index, title, subtitle, level, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TocItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|page|note|href|key|ref|className|style|children)$/]",
        "message": "<TocItem> doesn't accept that prop. Declared props: index, title, page, note, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|mono|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, size, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|accent|quiet|solid)$/]",
        "message": "<Tag> tone must be one of 'navy' | 'accent' | 'quiet' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Tag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|iconLeft|wrapperStyle|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, invalid, iconLeft, wrapperStyle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dash|style|key|ref|className|style|children)$/]",
        "message": "<TickLabel> doesn't accept that prop. Declared props: children, tone, dash, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|navy|quiet)$/]",
        "message": "<TickLabel> tone must be one of 'accent' | 'navy' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickMargin'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|tone|gap|style|key|ref|className|style|children)$/]",
        "message": "<TickMargin> doesn't accept that prop. Declared props: count, tone, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickMargin'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|navy|quiet)$/]",
        "message": "<TickMargin> tone must be one of 'accent' | 'navy' | 'quiet'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
